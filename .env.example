ENERGYPLUS_EXECUTABLE=C:\EnergyPlusV26-1-0\energyplus.exe
ENERGYPLUS_INSTALLATION_PATH=

# Optional demo inputs; otherwise scripts/demo_run.py searches data/input.
DEMO_IDF_PATH=
DEMO_WEATHER_FILE=

# Local Ollama server and model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_AUTO_PULL=false
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=1.0

# Deterministic decision-engine safety bounds
DECISION_MIN_TEMPERATURE_C=16.0
DECISION_MAX_TEMPERATURE_C=30.0
DECISION_MIN_FAN_PERCENT=0.0
DECISION_MAX_FAN_PERCENT=100.0

# Runtime behavior
SIMULATION_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
